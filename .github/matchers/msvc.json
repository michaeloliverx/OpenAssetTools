{
  "problemMatcher": [
    {
      "owner": "msvc",
      "pattern": [
        {
          "regexp": "^\\s*(?:\\d+>\\s*)?(.+?)\\((\\d+)(?:,(\\d+))?\\):\\s+(?:fatal\\s+)?(error|warning)\\s+(C\\d+):\\s*(.*?)(?:\\s+\\[([^\\[\\]]+\\.vcxproj)\\])?$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6,
          "fromPath": 7
        }
      ]
    }
  ]
}
